APP_NAME="SquadUp API"
ENVIRONMENT=development
DATABASE_URL=sqlite:///./squadup.db
# Em produção (docker-compose na VPS), o serviço `api` recebe DATABASE_URL já pronto via
# `environment:` no docker-compose.yml (aponta pro serviço `db`, Postgres em container) —
# não precisa duplicar aqui. Ver README.md "Deploy" e docker-compose.yml.
SECRET_KEY=change-me-in-.env
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
# Lista de origins separados por vírgula. Se omitido, usa os defaults de dev
# (localhost:8081, localhost:19006, exp://localhost:19000).
# Em produção, incluir a URL real do app publicado (Expo/EAS) assim que existir.
# CORS_ORIGINS=http://localhost:8081,http://localhost:19006,exp://localhost:19000

# --- Só usadas em produção (docker-compose na VPS), ver README.md "Deploy" ---
# Senha do Postgres em container (usada tanto pelo serviço `db` quanto embutida na
# DATABASE_URL montada pelo `api` em docker-compose.yml). Gerar um valor forte.
# POSTGRES_PASSWORD=changeme
# Hostname público que o Caddy vai expor via HTTPS automático (Let's Encrypt). Sem domínio
# próprio, usar um serviço de DNS wildcard gratuito apontando pro IP da VM, ex.:
# SITE_ADDRESS=203-0-113-10.nip.io

# Storage S3-compatible para upload de avatar (POST /users/me/avatar). Genérico: funciona com
# AWS S3, Cloudflare R2, Backblaze B2 etc. Sem essas 3 variáveis, o endpoint responde
# 503 STORAGE_NOT_CONFIGURED em vez de quebrar.
# S3_BUCKET=squadup-avatars
# S3_ACCESS_KEY_ID=changeme
# S3_SECRET_ACCESS_KEY=changeme
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_PUBLIC_URL_BASE=https://cdn.squadup.com

# Protege GET /metrics com o header X-Metrics-Token. Sem essa variável, o endpoint fica aberto
# (aceitável em dev/CI; definir em produção).
# METRICS_TOKEN=changeme
